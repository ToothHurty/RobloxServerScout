{
  "name": "RobloxServerScout 1.0",
  "manifest_version": 3,
  "version": "1.0",
  "description": "__MSG_description__",
  "short_name": "ServerScout",
  "default_locale": "en",
  "icons": {
    "16": "images/16x16.png",
    "32": "images/32x32.png",
    "48": "images/48x48.png",
    "128": "images/128x128.png"
  },
  "permissions": [
    "scripting"
  ],
  "background": {
    "service_worker": "backgroundService.js"
  },
  "host_permissions": [
    "https://*.roblox.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "https://*.roblox.com/*"
      ]
    }
  ]
}
